{
  "$schema": "http://json.schemastore.org/template",
  "author": "Your Name",
  "classifications": ["Clean Architecture", "WebAPI", "DDD"],
  "identity": "CleanArchitecture.Template",
  "name": ".NET Clean Architecture Template",
  "shortName": "cleanarch",
  "description": "A Clean Architecture solution template with Domain, Application, Infrastructure, and Presentation layers.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the projects.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10.0"
        },
        {
          "choice": "net9.0",
          "description": "Target .NET 9.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "UseDocker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include Dockerfile and docker-compose files."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!UseDocker)",
          "exclude": ["Dockerfile", "docker-compose.yml", "docker-compose.override.yml"]
        }
      ]
    }
  ]
}
