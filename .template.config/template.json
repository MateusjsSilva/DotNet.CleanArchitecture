{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mateus Silva",
  "classifications": ["Clean Architecture", "WebAPI", "DDD", "CQRS", "MediatR"],
  "identity": "CleanArchitecture.Template",
  "name": ".NET Clean Architecture Template",
  "shortName": "cleanarch",
  "description": "Production-ready Clean Architecture solution with Domain, Application, Infrastructure, and WebAPI layers. Includes CQRS/MediatR, EF Core, JWT auth, Outbox pattern, Soft Delete, Caching, OpenTelemetry, Prometheus/Grafana, and more.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the projects.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10.0"
        },
        {
          "choice": "net9.0",
          "description": "Target .NET 9.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "UseDocker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include Dockerfile, docker-compose (PostgreSQL, Redis, Jaeger, Prometheus, Grafana)."
    },
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the sample Products domain, API endpoints, tests, seed data, and sample migrations."
    },
    "UseRedis": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Configure distributed cache to use Redis instead of in-memory. Requires Redis connection string."
    },
    "IncludeAIModule": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Modules.AI example project (Claude API integration)."
    }
  },
  "sources": [
    {
      "exclude": [
        ".git/**",
        ".vs/**",
        ".idea/**",
        ".template-test*/**",
        "bin/**",
        "obj/**",
        "**/bin/**",
        "**/obj/**",
        "logs/**",
        "**/*.user"
      ],
      "modifiers": [
        {
          "condition": "(!IncludeSample)",
          "exclude": [
            "src/Domain/Entities/Product.cs",
            "src/Domain/Events/Product*.cs",
            "src/Domain/Interfaces/IProductRepository.cs",
            "src/Application/DTOs/Product*.cs",
            "src/Application/Interfaces/IProductQueries.cs",
            "src/Application/UseCases/Products/**",
            "src/Application/Validators/*Product*.cs",
            "src/Application/Validators/Common/ProductValidationRules.cs",
            "src/Infrastructure/Persistence/ApplicationDbContextSeeder.cs",
            "src/Infrastructure/Persistence/Configurations/ProductConfiguration.cs",
            "src/Infrastructure/Persistence/Repositories/Product*.cs",
            "src/Infrastructure/Persistence/Migrations/**",
            "src/WebAPI/Controllers/ProductsController.cs",
            "tests/UnitTests/Domain/Product*.cs",
            "tests/UnitTests/Products/**",
            "tests/IntegrationTests/Products/**",
            "tests/IntegrationTests/Outbox/OutboxTests.cs"
          ]
        },
        {
          "condition": "(!UseDocker)",
          "exclude": [
            "docker-compose.yml",
            "docker-compose.override.yml",
            "docker/**",
            "src/WebAPI/Dockerfile"
          ]
        },
        {
          "condition": "(!IncludeAIModule)",
          "exclude": [
            "src/Modules/AI/**"
          ]
        }
      ]
    }
  ]
}
